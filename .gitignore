# ═══════════════════════════════════════════════════════════════════════════
# Projeto JOI - .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
sdist/
wheels/
share/python-wheels/
*.whl
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing & coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/
coverage.xml

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Ruff
.ruff_cache/

# ─── Environment & secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.backup.*
*.env
!.env.example
secrets/
*.pem
*.key
*.crt

# ─── IDE / Editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.spyderproject
.spyproject
*.sublime-workspace
*.sublime-project

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Windows-specific ───────────────────────────────────────────────────────
# PowerShell temp files
*.tmp
*.bak
# Windows shortcuts (created by Explorer)
*.lnk
# Setup script log (if user redirects output)
setup.log

# ─── Docker ─────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─── Databases ──────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
data/
data/chroma/
postgres-data/
redis-data/

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
*.out
*.err
pip-log.txt
pip-delete-this-directory.txt

# ─── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Project specific ───────────────────────────────────────────────────────
# Local user persona overrides (not for git)
config/persona/*.local.yaml
config/persona/*.local.yml

# Generated artifacts
artifacts/
tmp/
