# ═══════════════════════════════════════════════════════════════════════════
# Projeto JOI - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All values are read by app/core/config.py via pydantic-settings.
# Sensitive values (API keys, passwords) should NEVER be committed to git.
# Get your Groq API key at: https://console.groq.com
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Projeto JOI"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ─── Security ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-DO-NOT-USE-IN-PROD-change-me-now
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:8000

# ─── Groq API (PRIMARY LLM PROVIDER) ────────────────────────────────────────
# Get a key at https://console.groq.com (free tier available)
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.1-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.7
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3

# ─── Ollama (LOCAL FALLBACK LLM) ────────────────────────────────────────────
# Install Ollama: https://ollama.com/download
# Pull model:    ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_ENABLED=true

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Local dev: docker-compose up postgres
# Connection format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://joi:joi_dev_password@localhost:5432/joi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ─── Redis ──────────────────────────────────────────────────────────────────
# Local dev: docker-compose up redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_NAMESPACE=joi

# ─── ChromaDB (vector store for episodic memory) ────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_EPISODES=episodic_memory
CHROMA_COLLECTION_FACTS=semantic_facts
CHROMA_EMBEDDING_MODEL=bge-m3

# ─── Memory System ──────────────────────────────────────────────────────────
MEMORY_WORKING_TTL_SECONDS=1800
MEMORY_MAX_CONTEXT_TURNS=12
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RERANK_ENABLED=true

# ─── Persona ────────────────────────────────────────────────────────────────
PERSONA_CONFIG_DIR=./config/persona
PERSONA_REINJECTION_INTERVAL=8
PERSONA_CONSISTENCY_CHECK_ENABLED=true

# ─── Rate Limiting & Budget ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MONTHLY_BUDGET_USD=100.0
BUDGET_ALERT_THRESHOLD=0.8

# ─── Feature Flags ──────────────────────────────────────────────────────────
FEATURE_STREAMING=true
FEATURE_MEMORY_PERSISTENCE=true
FEATURE_PERSONA_CONSISTENCY_CHECK=true
FEATURE_FALLBACK_LOCAL=true
